# ---------------------------------------------------------------------------
# Q1 part 1 — NAIVE, SINGLE-STAGE build.
# Deliberately written the "obvious" way: one stage, full python base, build
# toolchain installed, training done in-image, everything kept. This is the
# baseline whose size we measure against the multi-stage build.
# ---------------------------------------------------------------------------
FROM python:3.11-slim

WORKDIR /app

# Full Debian toolchain: needed only if a wheel has to be compiled from source,
# but on a single stage it is permanently baked into the shipped image.
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential gcc g++ gfortran \
    && rm -rf /var/lib/apt/lists/*

# Both training AND serving dependencies land in the final image.
COPY requirements-train.txt requirements.txt ./
RUN pip install -r requirements-train.txt -r requirements.txt

# Training happens inside the shipped image, so the generator, the trainer and
# the 1000-row CSV all stay behind in the final layer set.
COPY generate_dataset.py train.py main.py ./
RUN python generate_dataset.py && python train.py

ENV MODEL_PATH=/app/model.joblib \
    APP_VERSION=1.0.0 \
    PYTHONUNBUFFERED=1

EXPOSE 8000
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
